<!DOCTYPE html>
<html lang="en">
<head>
    <%-include("partials/head.ejs")%>
</head>
<body>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="/home" class="btn btn-outline-secondary m-1">Back</a>
        <h1 class="text-center flex-grow-1 m-0">All Authors</h1>
        <div style="width:80px;"></div>
    </div>

    <table class="table">
        <tr>
            <th>ID</th>
            <th>Name</th>
        </tr>
        <% for (let author of authors) { %>
            <tr>
                <td><%=author.authorId%></td>
                <td><%=author.name%></td>
                <td><a href="/editAuthor?authorId=<%=author.authorId%>">Edit</a></td>
                <td><a href="/deleteAuthor?authorId=<%=author.authorId%>">Delete</a></td>
            </tr>
        <% } %>
    </table>
    
    <%-include("partials/footer.ejs")%>
</body>
</html>
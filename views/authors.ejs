<!DOCTYPE html>
<html lang="en">
<head>
    <%-include("partials/head.ejs")%>
</head>
<body>
    <%-include("partials/nav.ejs")%>

    <div class="position-relative text-center mb-3">
        <h1 class="m-4">All Authors</h1>
    </div>

    <table class="table table-hover w-50 mx-auto">
        <thead>
            <tr>
            <th class="text-muted fw-normal small border-bottom">ID</th>
            <th class="text-muted fw-normal small border-bottom">Name</th>
            <th class="border-bottom"></th>
            <th class="border-bottom"></th>
            </tr>
        </thead>
        <tbody>
            <% for (let author of authors) { %>
            <tr>
                <td class="text-muted small align-middle"><%=author.authorId%></td>
                <td class="align-middle"><%=author.name%></td>
                <td class="align-middle text-end">
                <a href="/editAuthor?authorId=<%=author.authorId%>" class="btn btn-light border btn-sm px-3">Edit</a>
                </td>
                <td class="align-middle">
                <a href="/deleteAuthor?authorId=<%=author.authorId%>" class="btn btn-light btn-sm px-3 text-danger border border-danger-subtle">Delete</a>
                </td>
            </tr>
            <% } %>
        </tbody>
    </table>
    
    <%-include("partials/footer.ejs")%>
</body>
</html>
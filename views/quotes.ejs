<!DOCTYPE html>
<html lang="en">
<head>
    <%-include("partials/head.ejs")%>
</head>
<body>
    <%-include("partials/nav.ejs")%>

    <div class="position-relative text-center mb-3">
        <h1 class="m-4">All Quotes</h1>
    </div>

    <table class="table table-hover w-75 mx-auto">
        <thead>
            <tr>
            <th class="text-muted fw-normal small border-bottom">ID</th>
            <th class="text-muted fw-normal small border-bottom">Quote</th>
            <th class="border-bottom"></th>
            <th class="border-bottom"></th>
            </tr>
        </thead>
        <tbody>
            <% for (let quote of quotes) { %>
            <tr>
                <td class="text-muted small align-middle"><%=quote.quoteId%></td>
                <td class="align-middle"><%=quote.quote%></td>
                <td class="align-middle text-end">
                <a href="/editQuote?quoteId=<%=quote.quoteId%>" class="btn btn-light border btn-sm px-3">Edit</a>
                </td>
                <td class="align-middle">
                <a href="/deleteQuote?quoteId=<%=quote.quoteId%>" class="btn btn-sm btn-light px-3 text-danger border border-danger-subtle">Delete</a>
                </td>
            </tr>
            <% } %>
        </tbody>
    </table>
    
    <%-include("partials/footer.ejs")%>
</body>
</html>
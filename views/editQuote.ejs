<!DOCTYPE html>
<html lang="en">
<head>
    <%-include("partials/head.ejs")%>
</head>
<body>
    <%-include("partials/nav.ejs")%>

    <div class="position-relative text-center mb-3">
        <h1 class="m-4">Edit Quote</h1>
    </div>

    <div class="container">
        <form action="/updateQuote" method="POST" class="w-50 mx-auto">
            <input type="hidden" name="quoteId" value="<%=quote[0].quoteId%>">

            <div class="mb-3">
            <label class="form-label text-muted small">Quote</label>
            <textarea name="quote" id="quote" class="form-control" rows="3"><%=quote[0].quote%></textarea>
            </div>

            <div class="mb-3">
            <label class="form-label text-muted small">Author</label>
            <select name="authorId" class="form-select">
                <% for (let author of authors) { %>
                <option value="<%=author.authorId%>"
                    <%=quote[0].authorId == author.authorId ? "selected" : ""%>
                ><%=author.name%></option>
                <% } %>
            </select>
            </div>

            <div class="mb-3">
            <label class="form-label text-muted small">Category</label>
            <select name="category" class="form-select">
                <% for (let category of categories) { %>
                <option <%=quote[0].category == category.category ? "selected" : ""%>><%=category.category%></option>
                <% } %>
            </select>
            </div>

            <div class="mb-3">
            <label class="form-label text-muted small">Likes</label>
            <input type="number" name="likes" value="<%=quote[0].likes%>" class="form-control">
            </div>

            <div class="text-center mt-4">
            <button id="submitBtn" class="btn btn-light border px-4">Save Changes</button>
            </div>

            <div class="text-center mt-2">
            <span id="error" style="display:none"></span>
            </div>

        </form>
    </div>

    <%-include("partials/footer.ejs")%>

    <script>
        document.querySelector("#submitBtn").addEventListener("click", validateQuote);

        function validateQuote(e) {
            let quote = document.querySelector("#quote").value.trim();

            if (quote.length < 5) {
                e.preventDefault();
                let error = document.querySelector("#error");
                error.textContent = "Quote must be at least 5 characters!"
                error.style.color = "red";
                error.style.display = "inline";
            }
        }
    </script>
</body>
</html>
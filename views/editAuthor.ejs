<!DOCTYPE html>
<html lang="en">

<head>
    <%-include("partials/head.ejs")%>
</head>

<body>
    <%-include("partials/nav.ejs")%>

    <div class="position-relative text-center mb-3">
        <h1 class="m-4">Edit Author</h1>
    </div>

    <form action="/updateAuthor" method="POST" class="w-50 mx-auto">
        <input type="hidden" name="authorId" value="<%=author[0].authorId%>">

        <div class="mb-3">
            <label class="form-label text-muted small">First Name</label>
            <input type="text" name="firstName" value="<%=author[0].firstName%>" class="form-control">
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small">Last Name</label>
            <input type="text" name="lastName" value="<%=author[0].lastName%>" class="form-control">
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small d-block">Sex</label>
            <div class="d-flex gap-3">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="sex" value="M" id="sexM" <%=author[0].sex == "M" ? "checked" : ""%>>
                <label class="form-check-label" for="sexM">Male</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="sex" value="F" id="sexF" <%=author[0].sex == "F" ? "checked" : ""%>>
                <label class="form-check-label" for="sexF">Female</label>
            </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small">Country</label>
            <input type="text" name="country" value="<%=author[0].country%>" class="form-control">
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small">Profession</label>
            <input type="text" name="profession" value="<%=author[0].profession%>" class="form-control">
        </div>

        <div class="row mb-3">
            <div class="col">
            <label class="form-label text-muted small">Date of Birth</label>
            <input type="date" name="dob" value="<%=author[0].ISOdob%>" class="form-control">
            </div>
            <div class="col">
            <label class="form-label text-muted small">Date of Death</label>
            <input type="date" name="dod" value="<%=author[0].ISOdod%>" class="form-control">
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small">Biography</label>
            <textarea name="bio" class="form-control" rows="3"><%=author[0].biography%></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small">Portrait URL</label>
            <textarea name="portrait" class="form-control" rows="2"><%=author[0].portrait%></textarea>
        </div>

        <div class="text-center mt-4">
            <button class="btn btn-light border px-4">Save Changes</button>
        </div>

    </form>

    <%-include("partials/footer.ejs")%>
</body>

</html>